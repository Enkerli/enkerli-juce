#!/bin/bash
# suite-build — one entry point for building/validating any (or all) of the
# suite's JUCE plugin repos, instead of memorizing seven repos' worth of
# per-repo cmake incantations (BUILD.md §4, music-suite docs/KNOWLEDGE_TRANSFER.md
# item 2). Wraps, and does not replace, `validate.sh` — the automatable ladder
# (macOS build → hollow-bundle check → iOS compile → auval → pluginval) stays
# exactly as debugged there; this just knows WHICH repo needs WHICH ladder
# arguments, and adds the Linux leg validate.sh doesn't cover.
#
# Usage:
#   suite-build <repo[,repo...]|all> [--formats au,auv3,vst3,clap,lv2] [--ladder] [--fresh] [--ios] [--pull] [--no-install] [--no-clone] [--no-link] [--dry-run]
#   suite-build --list
#
# <repo> is a manifest alias below (midicurator, proggenie, pitchfold, vane,
# serpe, drawnqurve, workspace), a COMMA-separated list of aliases (e.g.
# `drawnqurve,serpe,proggenie` — no spaces), or "all". A list of 2+ aliases
# gets the same keep-going-and-summarize behavior as "all", just scoped to
# those repos. Repos are found as SIBLINGS of this script's enkerli-juce
# checkout by default (`$SUITE_ROOT/<dir>`), matched case-INSENSITIVELY if
# the exact GitHub casing (Vane, PitchFold, DrawnQurve) isn't what's on disk
# — override the whole sibling root with `export SUITE_ROOT=/path/to/parent`.
#
# music-suite is looked up separately, as `MUSIC_SUITE` (default
# `$SUITE_ROOT/music-suite`; override with `export MUSIC_SUITE=/path/to/
# music-suite`) — only consulted for midicurator/proggenie's WebUI-regen
# prebuild step. The OTHER five repos (pitchfold, vane, serpe, drawnqurve,
# workspace) find music-suite themselves at CMake time, independent of this
# script — see BUILD.md §4 in music-suite for their sibling/nested/
# `MUSIC_SUITE`-env/`webui.local.cmake` probing order.
#
# JUCE itself is looked up once via `JUCE_PATH` (default `$SUITE_ROOT/JUCE`;
# override with `export JUCE_PATH=/path/to/JUCE`) so all seven repos share
# ONE local JUCE checkout instead of each `FetchContent`-ing (and building)
# its own ~500MB copy — clone juce-framework/JUCE as an eighth sibling once
# and this just works. Same for CLAP: `CLAP_JUCE_PATH` is the analogous
# override, checked per-repo (`$repo/clap-juce-extensions` by default) since
# it isn't spread across repos the way JUCE_PATH is.
#
#   --ladder    Run the FULL automatable ladder (macOS: validate.sh's build +
#               hollow-bundle check + iOS compile + auval + pluginval; Linux:
#               the LV2/VST3/CLAP/Standalone build, no auval/pluginval — unavailable
#               there). Bare (no --ladder): a plain macOS `build` for a faster
#               inner loop, or the Linux build (there is no "quick" Linux path
#               distinct from the ladder — it's already just a cmake build).
#   --formats   Target filter, e.g. --formats vst3,clap → cmake --build
#               --target <Product>_VST3 <Product>_CLAP. Works on the quick
#               (non-ladder) macOS path AND the Linux path. Available formats
#               are platform-dependent: macOS builds au/auv3/vst3/clap/standalone,
#               Linux builds lv2/vst3/clap/standalone (no au — that's
#               Apple-only). Asking for a format the platform doesn't build
#               just gets a "target not found" from cmake. Has no effect
#               under --ladder — validate.sh's ladder is a fixed sequence. If
#               a repo's CMake doesn't name targets exactly this way, drop
#               --formats and let it build everything (documented per-repo
#               naming in BUILD.md is the source of truth if this guess is
#               wrong).
#   --fresh     Wipe build/build-ios/build-linux first — catches the stale/
#               hollow-bundle class of bug validate.sh's own check exists for
#               (a "successful" incremental build can still ship old bytes).
#   --ios       Also do the iOS unsigned compile, standalone from --ladder
#               (e.g. you want just the compile check, not the whole ladder).
#   --pull      Update first: music-suite, then each selected repo and its
#               submodules (git pull --ff-only). Replaces the by-hand
#               nine-repo for-loop in BUILD.md's Quickstart. A repo with
#               local changes fails loudly rather than being skipped — the
#               one exception is the two committed WebUI bundles, which are
#               generated files this script rewrites anyway.
#   --no-clone  Do not clone anything. By default a missing repo, a missing
#               music-suite, a missing JUCE and a missing clap-juce-extensions
#               are all cloned into SUITE_ROOT — so a machine with nothing on
#               it is a supported starting point, not a prerequisite.
#   --no-link   Do not touch the global `msuite`. By default the checkout you
#               just built becomes the one `msuite` runs (npm link), because a
#               global link otherwise keeps pointing at whichever tree was
#               linked first.
#   --no-install  Do not copy the built plugins into the user plug-in folders.
#               Those folders are SHARED, so a branch build otherwise replaces
#               whatever your DAW loads, with nothing on screen to say which
#               build it is. Use this for every experimental branch; the
#               artefacts stay under build/ and the Standalone still runs.
#   --dry-run   Print every command instead of running it. Use this to sanity
#               check a repo/flag combination before committing to a real
#               build — especially useful on a machine you haven't run this
#               on before.
#
# `all` (or a comma-separated repo list) builds every repo it can find and
# keeps going past one that's missing or fails — a consolidation-in-progress
# checkout won't always have every sibling yet — then prints a pass/fail
# summary and exits non-zero if anything failed.
#
# Two repos (MIDIcurator, Progression Studio) commit their WebUI bundle
# instead of building it live — the trap that shipped GloriArp two weeks
# stale twice in July 2026. This script ALWAYS regenerates it first for those
# two, every invocation, so that trap can't recur through this entry point.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JUCE_REPO="$(cd "$HERE/.." && pwd)"                      # .../enkerli-juce (this script lives in its tools/)
SUITE_ROOT="${SUITE_ROOT:-$(cd "$JUCE_REPO/.." && pwd)}" # parent of enkerli-juce, by default
# Two layouts are supported (BUILD.md §4.0): repos as SIBLINGS of music-suite
# (the default), or repos NESTED inside the music-suite checkout — in which
# case SUITE_ROOT already IS music-suite and "$SUITE_ROOT/music-suite" would
# not exist. Detect that rather than failing with a confusing "not found".
if [ -z "${MUSIC_SUITE:-}" ]; then
  if [ -f "$SUITE_ROOT/music-suite/package.json" ]; then MUSIC_SUITE="$SUITE_ROOT/music-suite"
  elif [ -f "$SUITE_ROOT/package.json" ] && [ -d "$SUITE_ROOT/apps" ]; then MUSIC_SUITE="$SUITE_ROOT"
  else MUSIC_SUITE="$SUITE_ROOT/music-suite"; fi   # keep the old path for the error message
fi
export MUSIC_SUITE                                 # the five CMake-side repos probe this too
# One shared local JUCE for all seven repos (2026-07-21). Resolve it the same
# way the CMake side does — shared checkout, then the macOS install — instead
# of exporting a path that may not exist: an unset-but-exported JUCE_PATH still
# "worked" (cmake fell through to /Applications/JUCE on its own) while leaving
# this script unable to reason about WHICH JUCE a build actually used, which is
# what the stale-cache check below needs to know (2026-07-27).
if [ -z "${JUCE_PATH:-}" ]; then
  if   [ -f "$SUITE_ROOT/JUCE/CMakeLists.txt" ]; then JUCE_PATH="$SUITE_ROOT/JUCE"
  elif [ -f /Applications/JUCE/CMakeLists.txt ]; then JUCE_PATH=/Applications/JUCE
  else JUCE_PATH="$SUITE_ROOT/JUCE"; fi   # nonexistent: repos will FetchContent, and say so
fi
export JUCE_PATH                                         # enkerli_resolve_juce() (EnkerliPlugin.cmake) reads this

# The OTHER heavy dependency: clap-juce-extensions carries the CLAP SDK as
# submodules, so a per-repo FetchContent is the slowest thing in a cold build
# — and every CLAP-building repo did one. Same treatment as JUCE: one shared
# checkout beside the repos, exported, probed by all three resolution sites
# (the archetype, Vane, DrawnQurve) before they fetch (2026-07-27).
if [ -z "${CLAP_JUCE_PATH:-}" ] && [ -f "$SUITE_ROOT/clap-juce-extensions/CMakeLists.txt" ]; then
  CLAP_JUCE_PATH="$SUITE_ROOT/clap-juce-extensions"
fi
[ -n "${CLAP_JUCE_PATH:-}" ] && export CLAP_JUCE_PATH
JUCE_TAG=8.0.13
VALIDATE="$JUCE_REPO/tools/validate.sh"

# Per-repo detail for the summary. build_one runs in a subshell, so it reports
# by writing here rather than by setting a variable. Before this, a run of
# `suite-build all --ladder` printed seven bare OK lines and threw away every
# formatpluginval result behind them (Alex, 2026-07-30: "Not much info, though").
SB_DETAIL="$(mktemp -d)"
trap 'rm -rf "$SB_DETAIL"' EXIT
note() { printf '%s\n' "$*" >> "$SB_DETAIL/${alias:-unknown}"; }
JOBS="$( (sysctl -n hw.ncpu || nproc) 2>/dev/null || echo 4 )"  # macOS has no nproc
INSTALL_ARG=""
DRY_RUN=0

# ── Manifest: alias -> "dir|type|code|target|prebuild|linux" ───────────────
# type: aumi (MIDI effect) | aumu (instrument). prebuild: shell command run
# in the repo dir before cmake, or "-" for none. linux: 1 if a build-linux
# (LV2/Standalone/CLAP) configuration is expected to work.
#
# The 4th field is the **CMake target base name** (what --formats appends
# _AU/_VST3/… to), NOT the marketing product name — they differ in two repos
# and both were wrong until 2026-07-27, silently, because a bare build never
# names a target:
#   · DrawnQurve's target is "DrawnCurve" — a historical rename BUILD.md says
#     is too entangled to undo (PRODUCT_NAME is still "DrawnQurve");
#   · workspace-plugin's target is "Workspace", PRODUCT_NAME "Suite Workspace"
#     (the old space-stripping guess produced "SuiteWorkspace").
#
# A `case` lookup, not `declare -A`: this script's shebang (`#!/bin/bash`)
# always resolves to macOS's stock `/bin/bash`, frozen at 3.2.57 (the last
# GPLv2 release — Apple never shipped bash 4+) even when a newer bash is on
# PATH via Homebrew. Bash 3.2 has no associative arrays; `declare -A` there
# silently drops `-A`, and `[midicurator]=...` gets parsed as an *indexed*
# subscript — an arithmetic expression — which under `set -u` fails as
# "midicurator: unbound variable" (2026-07-21 field report). A `case`
# needs nothing newer than bash 3.2.
plugin_spec() {
  case "$1" in
    midicurator) printf '%s\n' "midicurator-plugin|aumi|Mcur|MIDIcurator|node WebUI/build.mjs ${MUSIC_SUITE}/apps/MIDIcurator|1" ;;
    proggenie)   printf '%s\n' "progression-studio-plugin|aumi|Prst|Progression Studio|node WebUI/build.mjs ${MUSIC_SUITE}/apps/progression-studio|1" ;;
    pitchfold)   printf '%s\n' "PitchFold|aumi|Pqf1|PitchFold|-|1" ;;
    vane)        printf '%s\n' "Vane|aumu|VAne|Vane|-|1" ;;
    serpe)       printf '%s\n' "rhythm_pattern_explorer|aumi|RPEd|Serpe|-|1" ;;
    drawnqurve)  printf '%s\n' "DrawnQurve|aumi|Dqau|DrawnCurve|-|1" ;;
    workspace)   printf '%s\n' "workspace-plugin|aumi|Wksp|Workspace|-|1" ;;
    *) return 1 ;;
  esac
}
ORDER=(midicurator proggenie pitchfold vane serpe drawnqurve workspace)

# A repo dir under SUITE_ROOT, tolerant of case: the manifest above spells
# each dir with its real GitHub casing (Vane, PitchFold, DrawnQurve), but a
# clone can easily end up lowercase (a case-insensitive host filesystem, a
# script that normalized it, a manual `git clone ... vane`) — Linux itself
# is case-sensitive, so that mismatch used to be a hard FAIL even though the
# repo was right there. Exact match wins when present (no filesystem scan);
# otherwise one case-insensitive `find` at SUITE_ROOT's top level. Echoes
# nothing and returns 1 if neither exists — callers do their own reporting.
resolve_dir() {
  local root="$1" dir="$2"
  if [ -d "$root/$dir" ]; then printf '%s\n' "$root/$dir"; return 0; fi
  local found
  found="$(find "$root" -maxdepth 1 -iname "$dir" -type d 2>/dev/null | head -1)"
  [ -n "$found" ] && { printf '%s\n' "$found"; return 0; }
  return 1
}

usage() {
  sed -n '2,58p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
  exit "${1:-0}"
}

# Maps one --formats token to this repo's cmake target name. Shared by the
# macOS quick-build path and the Linux path (Linux only ever has standalone/
# lv2/clap targets to actually pick from — asking for au/vst3 there just
# gets a "target not found" from cmake itself, which is clear enough).
# Returns 1 (no output) for an unrecognized token; caller reports it.
format_target() {
  local product="$1" fmt="$2"
  case "$fmt" in
    standalone) printf '%s\n' "${product// /}_Standalone" ;;
    au)         printf '%s\n' "${product// /}_AU" ;;
    vst3)       printf '%s\n' "${product// /}_VST3" ;;
    clap)       printf '%s\n' "${product// /}_CLAP" ;;
    auv3)       printf '%s\n' "${product// /}_AUv3" ;;
    lv2)        printf '%s\n' "${product// /}_LV2" ;;
    *) return 1 ;;
  esac
}

# Which targets did configure actually produce? Asking beats guessing: AUv3 is
# a real macOS target for Vane but an iPadOS-only one for the archetype repos,
# and "make: No rule to make target `Serpe_AUv3'" does not tell you that — it
# just aborts the repo. With this, an unavailable format is reported and
# skipped, and only an ENTIRELY unbuildable request is fatal.
existing_targets() {
  local b="$1"
  if [ -f "$b/build.ninja" ]; then ninja -C "$b" -t targets all 2>/dev/null | sed 's/:.*//'
  else cmake --build "$b" --target help 2>/dev/null | sed -n 's/^\.\.\. //p'; fi
}
# Filters "$@" (targets) against what exists in build dir $1. Prints the
# survivors; notes the rest on stderr.
filter_targets() {
  local b="$1"; shift
  local avail; avail="$(existing_targets "$b")"
  local keep=() t
  for t in "$@"; do
    if printf '%s\n' "$avail" | grep -qx "$t"; then keep+=("$t")
    elif [ "${t##*_}" = "AUv3" ]; then
      printf 'NOTE: %s is not built here — AUv3 is the iPadOS format for this repo; use --ios (then sign/install in Xcode).\n' "$t" >&2
    else
      printf 'NOTE: %s is not a target of this repo on this platform — skipped.\n' "$t" >&2
    fi
  done
  printf '%s\n' "${keep[@]:-}"
}

# A build dir configured when the repo fetched its OWN JUCE cannot be reused
# once a shared JUCE_PATH exists: JUCE's nested helper sub-builds (vst3_helper,
# juce tools) keep the old source path in their own CMakeCache, and cmake hard-
# errors with "does not match the source ... used to generate cache". Every
# repo hits this exactly once, on the first shared-JUCE build (both Vane and
# DrawnQurve did, 2026-07-27). Detect it and regenerate rather than hand the
# user a cmake error whose fix (--fresh) it never mentions.
juce_cache_stale() {
  local b="$1"
  [ -d "$b" ] || return 1
  [ -n "${JUCE_PATH:-}" ] && [ -f "$JUCE_PATH/CMakeLists.txt" ] || return 1
  grep -rq "_deps/juce-src" "$b" --include=CMakeCache.txt 2>/dev/null
}
drop_stale_juce_cache() {   # $@ = build dirs
  local b
  for b in "$@"; do
    if juce_cache_stale "$b"; then
      printf -- '— %s was configured against a privately fetched JUCE; regenerating it against %s\n' "$b" "$JUCE_PATH"
      run "rm -rf \"$b\"" || return 1
    fi
  done
}

list() {
  printf '%-12s %-28s %-5s %-5s %s\n' ALIAS DIR TYPE CODE TARGET
  for a in "${ORDER[@]}"; do
    IFS='|' read -r dir type code product _ _ <<<"$(plugin_spec "$a")"
    printf '%-12s %-28s %-5s %-5s %s\n' "$a" "$dir" "$type" "$code" "$product"
  done
  exit 0
}

# Hard-exit for argument-parsing problems, before any repo is touched.
usage_fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }

run() {
  if [ "$DRY_RUN" = 1 ]; then printf '+ %s\n' "$*"; else eval "$@"; fi
}

# Returns 1 (does NOT exit the whole script) — so `all` can keep going past
# one repo that's absent or fails, and a single-repo invocation still exits
# non-zero at the end via build_one's own return value.
build_one() {
  local alias="$1"
  local spec
  if ! spec="$(plugin_spec "$alias")"; then
    printf 'FAIL: unknown repo alias "%s" — suite-build --list\n' "$alias" >&2
    return 1
  fi
  local dir type code product prebuild linux
  IFS='|' read -r dir type code product prebuild linux <<<"$spec"
  local path
  if ! path="$(resolve_dir "$SUITE_ROOT" "$dir")"; then
    # A bare machine is a supported starting point: clone it rather than
    # reporting homework. --no-clone restores the old behaviour.
    if [ "$NO_CLONE" != 1 ] && clone_into "$SUITE_ROOT/$dir" "$dir" "--recurse-submodules"; then
      path="$SUITE_ROOT/$dir"
    else
      printf 'FAIL: %s: not found at %s and not cloned — set SUITE_ROOT, check it out as a sibling, or drop --no-clone\n' "$alias" "$SUITE_ROOT/$dir" >&2
      return 1
    fi
  fi

  printf '\n=== %s (%s) ===\n' "$product" "$path"
  (
    # set -e HERE (not at script scope) is defense-in-depth, not the actual
    # failure mechanism: when this whole subshell is invoked as `if build_one
    # ...; then` (every "all"/multi-repo run), bash SUPPRESSES errexit for
    # the entire compound command being tested — including in here, even
    # though this is its own subshell (a real 2026-07-21 field report: a
    # cmake --build failure printed its error but the summary still said
    # "OK", because nothing downstream of the failure ever re-checked $?).
    # So every step below that must be fatal checks its own exit status
    # explicitly via `|| exit 1` — never relying on implicit -e propagation.
    set -euo pipefail
    cd "$path" || exit 1

    if [ "$PULL" = 1 ]; then
      printf -- '— pull\n'
      pull_repo "$path" "$alias" || exit 1
    fi

    if [ "$prebuild" != "-" ]; then
      if [ ! -d "$MUSIC_SUITE" ]; then
        printf 'FAIL: %s: music-suite not found at %s — set MUSIC_SUITE, or check it out as a sibling named "music-suite"\n' "$alias" "$MUSIC_SUITE" >&2
        exit 1
      fi
      printf -- '— WebUI regen (committed bundle: %s)\n' "$product"
      run "$prebuild" || exit 1
    fi

    if [ "$FRESH" = 1 ]; then
      printf -- '— fresh: wiping build dirs\n'
      run "rm -rf build build-ios build-linux build-macos build-mac" || exit 1
    fi

    is_linux=0
    [ "$(uname -s)" = "Linux" ] && is_linux=1

    if [ "$is_linux" = 1 ]; then
      if [ "$linux" != 1 ]; then
        printf 'FAIL: %s: no Linux build documented for this repo (BUILD.md) — check by hand first\n' "$alias" >&2
        exit 1
      fi
      drop_stale_juce_cache build-linux || exit 1
      run "cmake -B build-linux $INSTALL_ARG" || exit 1

      # The LV2 target's manifest step runs the built plugin headlessly to
      # introspect it; without a display that can crash (Gtk "cannot open
      # display" / SIGPIPE — a real 2026-07-21 field report). xvfb-run gives
      # it a throwaway virtual one; Standalone/CLAP don't need this at all.
      XVFB=""
      if command -v xvfb-run >/dev/null 2>&1; then
        XVFB="xvfb-run -a"
      else
        printf 'NOTE: xvfb-run not found (apt/dnf/pacman package "xvfb") — if the\n      LV2 target fails below with "cannot open display" or a SIGPIPE\n      (exit 141), that'"'"'s why; Standalone and CLAP are unaffected.\n' >&2
      fi

      if [ -n "$FORMATS" ]; then
        targets=()
        IFS=',' read -ra fs <<<"$FORMATS"
        for f in "${fs[@]}"; do
          t="$(format_target "$product" "$f")" || {
            printf 'FAIL: unknown format "%s" (Linux builds: lv2, vst3, clap, standalone — no au)\n' "$f" >&2
            exit 1
          }
          targets+=("$t")
        done
        if [ "$DRY_RUN" != 1 ]; then
          buildable=()
          while IFS= read -r t; do [ -n "$t" ] && buildable+=("$t"); done < <(filter_targets build-linux "${targets[@]}")
          [ "${#buildable[@]}" -gt 0 ] || { printf 'FAIL: none of the requested formats exist in this repo on Linux.\n' >&2; exit 1; }
          targets=("${buildable[@]}")
        fi
        printf -- '— Linux: %s\n' "${targets[*]}"
        run "$XVFB cmake --build build-linux -j\$(nproc) --target ${targets[*]}" || exit 1
        note "built: ${targets[*]}"
      else
        printf -- '— Linux: LV2/VST3/CLAP/Standalone\n'
        run "$XVFB cmake --build build-linux -j\$(nproc)" || exit 1
        note "built: LV2 VST3 CLAP Standalone"
      fi
      # --ladder is macOS-only: validate.sh drives auval and xcodebuild. It used
      # to be ignored here in silence, so a Linux `--ladder` run reported OK for
      # every repo having validated nothing. Say so instead.
      if [ "$LADDER" = 1 ]; then
        printf -- '— NOTE: --ladder is macOS-only (auval/xcodebuild); this was a BUILD only\n' >&2
        note "ladder: SKIPPED — macOS-only (auval/xcodebuild), Linux ran the build only"
      fi
      exit 0
    fi

    # macOS.
    drop_stale_juce_cache build build-ios || exit 1
    if [ "$LADDER" = 1 ]; then
      printf -- '— full ladder via validate.sh\n'
      # Tee so the rungs it reached can be reported. validate.sh exits on the
      # first failure, so every step it printed before that one passed.
      _lad="$SB_DETAIL/${alias}.ladder"
      if [ "$DRY_RUN" = 1 ]; then
        run "\"$VALIDATE\" \"$path\" \"$type\" \"$code\" \"$product\"" || exit 1
      else
        "$VALIDATE" "$path" "$type" "$code" "$product" 2>&1 | tee "$_lad"
        [ "${PIPESTATUS[0]}" = 0 ] || { note "ladder: FAILED at $(grep -c '^— ' "$_lad" 2>/dev/null) rung(s) in"; exit 1; }
      fi
      if [ -f "$_lad" ]; then
        # awk, not `paste -sd' · '`: paste takes a single BYTE as its delimiter,
        # so a multibyte separator comes out mangled.
        _rungs="$(sed -n 's/^— //p' "$_lad" | awk '{ printf "%s%s", (NR>1 ? " | " : ""), $0 } END { print "" }')"
        note "ladder: ${_rungs:-none reported}"
        grep -q "pluginval not installed" "$_lad" && note "  (pluginval skipped — not installed)"
      fi
    else
      printf -- '— quick build (add --ladder for the full automatable ladder)\n'
      if [ -n "$FORMATS" ]; then
        targets=()
        IFS=',' read -ra fs <<<"$FORMATS"
        for f in "${fs[@]}"; do
          t="$(format_target "$product" "$f")" || {
            printf 'FAIL: unknown format "%s" (macOS: au, auv3, vst3, clap, standalone)\n' "$f" >&2
            exit 1
          }
          targets+=("$t")
        done
        run "cmake -B build -DCMAKE_BUILD_TYPE=Release $INSTALL_ARG" || exit 1
        if [ "$DRY_RUN" != 1 ]; then
          buildable=()
          while IFS= read -r t; do [ -n "$t" ] && buildable+=("$t"); done < <(filter_targets build "${targets[@]}")
          [ "${#buildable[@]}" -gt 0 ] || { printf 'FAIL: none of the requested formats exist in this repo on macOS.\n' >&2; exit 1; }
          targets=("${buildable[@]}")
        fi
        run "cmake --build build -j $JOBS --target ${targets[*]}" || exit 1
        note "built: ${targets[*]}"
      else
        run "cmake -B build -DCMAKE_BUILD_TYPE=Release $INSTALL_ARG" || exit 1
        run "cmake --build build -j $JOBS" || exit 1
        note "built: all targets (AU/VST3/CLAP/Standalone + tools)"
      fi
    fi

    if [ "$IOS" = 1 ] && [ "$LADDER" != 1 ]; then
      printf -- '— iOS unsigned compile\n'
      run "cmake -B build-ios -G Xcode -DCMAKE_SYSTEM_NAME=iOS -DCMAKE_OSX_DEPLOYMENT_TARGET=16.0" || exit 1
      run "cmake --build build-ios --config Release -- CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO" || exit 1
    fi
  )
}

# The two committed-bundle repos bundle `@enkerli/*` from packages/*/dist,
# and dist/ is gitignored — so a pull that changed theory/ui leaves a fresh
# app source compiled against STALE shared code (or none at all, on a new
# clone). `tsc -b` is incremental: a no-op when current, essential when not.
# Pulling was the biggest thing this script left you to do by hand (BUILD.md's
# Quickstart still carries the nine-repo for-loop). --pull folds it in: the
# monorepo, then each selected repo and its submodules, reported per repo.
pull_repo() {   # $1 = dir, $2 = label
  local d="$1" label="$2"
  # The committed WebUI bundle is GENERATED and rewritten below, so a locally
  # rebuilt one blocks the pull. Discard it — and only it — when it is the
  # sole change; anything else is left alone and the pull fails loudly.
  if [ "$(git -C "$d" status --porcelain 2>/dev/null | wc -l | tr -d ' ')" = 1 ] \
     && git -C "$d" status --porcelain 2>/dev/null | grep -q '^ M WebUI/index.html$'; then
    printf -- '  (discarding the locally regenerated WebUI bundle — rebuilt below)\n'
    run "git -C \"$d\" checkout -- WebUI/index.html" || return 1
  fi
  # --autostash, not a bare pull: incidental local changes (above all
  # package-lock.json, which npm rewrites — including npm install run by THIS
  # script, so a bare pull could be blocked by our own side effect) are
  # stashed, the pull happens, and they are reapplied. Nothing is discarded;
  # if reapplying conflicts, git leaves the stash and this reports the failure.
  if run "git -C \"$d\" pull --ff-only --autostash --quiet && git -C \"$d\" submodule update --init --recursive --quiet"; then
    printf -- '  %s now at %s\n' "$label" "$(git -C "$d" log -1 --format=%h 2>/dev/null)"
  else
    printf 'FAIL: %s: git pull failed (local changes, or diverged) — resolve it and re-run.\n' "$label" >&2
    return 1
  fi
}

# ── Bootstrap: make a bare machine work, and make THIS root the one that runs ─
# Two cases have to behave (2026-07-27): a device with nothing from the suite
# on it, and a device that already has builds — possibly in another directory.
# Case 1 needs the repos and shared dependencies cloned; case 2 needs the
# command you type to point at the tree you just built, not whichever checkout
# happened to be linked first. Both are the default path; --no-clone and
# --no-link opt out.
GH=https://github.com/Enkerli

clone_into() {   # $1 = destination dir, $2 = repo name, $3 = extra git args
  [ "$NO_CLONE" = 1 ] && return 1
  printf -- '— cloning %s → %s\n' "$2" "$1"
  run "git clone --quiet $3 \"$GH/$2\" \"$1\"" || {
    printf 'FAIL: could not clone %s\n' "$2" >&2; return 1; }
}

bootstrap() {
  # music-suite itself: everything else needs its apps/ and packages/.
  if [ ! -f "$MUSIC_SUITE/package.json" ] && [ "$NO_CLONE" != 1 ]; then
    clone_into "$MUSIC_SUITE" "music-suite" "--recurse-submodules" || return 1
  fi
  # One JUCE. macOS usually has /Applications/JUCE; Linux has no standard
  # location, so this defines one rather than letting seven repos each fetch
  # (and build) their own ~500MB copy.
  if [ ! -f "$JUCE_PATH/CMakeLists.txt" ] && [ "$NO_CLONE" != 1 ]; then
    printf -- '— no JUCE found; cloning %s once, shared by every repo\n' "$JUCE_TAG"
    run "git clone --quiet --depth 1 --branch $JUCE_TAG https://github.com/juce-framework/JUCE \"$SUITE_ROOT/JUCE\"" \
      && JUCE_PATH="$SUITE_ROOT/JUCE" && export JUCE_PATH
  fi
  # Same for clap-juce-extensions (it carries the CLAP SDK as submodules, so a
  # per-repo fetch is the slowest thing in a cold build).
  if [ -z "${CLAP_JUCE_PATH:-}" ] && [ ! -f "$SUITE_ROOT/clap-juce-extensions/CMakeLists.txt" ] && [ "$NO_CLONE" != 1 ]; then
    printf -- '— cloning clap-juce-extensions once, shared by every repo\n'
    run "git clone --quiet --recurse-submodules https://github.com/free-audio/clap-juce-extensions \"$SUITE_ROOT/clap-juce-extensions\"" || true
  fi
  [ -f "$SUITE_ROOT/clap-juce-extensions/CMakeLists.txt" ] && { CLAP_JUCE_PATH="$SUITE_ROOT/clap-juce-extensions"; export CLAP_JUCE_PATH; }
  return 0
}

# Make the checkout we just built the one `msuite` runs. A global link binds to
# ONE tree; update another and the command silently keeps running the old
# source (@enkerli/upi loads straight from src/, so there is no stale dist to
# give it away — a 2026-07-27 field report where A(2,2,3,2) parsed on one
# machine and not the other, same commit, two roots).
link_cli() {
  [ "$NO_LINK" = 1 ] && return 0
  local cur rp
  if cur="$(command -v msuite 2>/dev/null)"; then
    rp="$(readlink -f "$cur" 2>/dev/null \
          || python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$cur" 2>/dev/null \
          || printf '%s' "$cur")"
    case "$rp" in "$MUSIC_SUITE"/*) return 0 ;; esac      # already this tree
    printf -- '— msuite currently runs %s — relinking to this checkout\n' "$rp"
  else
    printf -- '— msuite is not on PATH — linking it\n'
  fi
  if run "(cd \"$MUSIC_SUITE\" && npm link -w @enkerli/cli >/dev/null 2>&1)"; then
    printf -- '  msuite → %s\n' "$MUSIC_SUITE"
    return 0
  fi
  # npm's global prefix usually is not user-writable; sudo prompts in the
  # user's own terminal, which is why this is offered rather than assumed.
  if [ -t 0 ] && [ "$DRY_RUN" != 1 ]; then
    printf -- '  the npm global prefix needs root; running: sudo npm link -w @enkerli/cli\n'
    if (cd "$MUSIC_SUITE" && sudo npm link -w @enkerli/cli >/dev/null 2>&1); then
      printf -- '  msuite → %s\n' "$MUSIC_SUITE"; return 0
    fi
  fi
  printf 'NOTE: could not link msuite. Run it yourself:\n        (cd "%s" && sudo npm link -w @enkerli/cli)\n' "$MUSIC_SUITE" >&2
  return 0   # never fail a build over this
}

monorepo_prep() {
  if [ "$NO_NODE" = 1 ]; then printf -- '— monorepo prep skipped (--no-node)\n'; return 0; fi
  if [ ! -d "$MUSIC_SUITE" ]; then
    printf 'NOTE: music-suite not found at %s — skipping the shared-package build.\n      MIDIcurator/ProgGenie bundles would be built against whatever dist/ is there.\n' "$MUSIC_SUITE" >&2
    return 0
  fi
  if [ "$PULL" = 1 ]; then
    printf -- '— pulling music-suite\n'
    pull_repo "$MUSIC_SUITE" "music-suite" || return 1
  fi
  if [ ! -d "$MUSIC_SUITE/node_modules" ]; then
    # Do it rather than instruct: "run npm install first" is exactly the
    # preparation this entry point exists to remove.
    # `npm ci` before `npm install`: it installs exactly what the lockfile
    # says and does NOT rewrite it. Plain install can churn the lock (npm
    # versions differ between machines), which then blocks the next --pull —
    # a mess this script used to create for itself. ci needs the lock to match
    # package.json, so fall back when it does not.
    printf -- '— installing monorepo dependencies (first run in this checkout)\n'
    run "(cd \"$MUSIC_SUITE\" && npm ci --no-audit --no-fund >/dev/null 2>&1)" \
      || run "(cd \"$MUSIC_SUITE\" && npm install --no-audit --no-fund >/dev/null)" \
      || { printf 'FAIL: could not install dependencies in %s\n' "$MUSIC_SUITE" >&2; return 1; }
  fi
  printf -- '— shared packages (@enkerli/*): tsc -b\n'
  run "(cd \"$MUSIC_SUITE\" && npm run build-packages >/dev/null)" || {
    printf 'FAIL: shared packages did not build — every WebUI bundle below would be stale.\n' >&2
    return 1
  }
  link_cli
}

# ── Arg parsing ───────────────────────────────────────────────────────────
[ $# -eq 0 ] && usage 1
REPO=""
FORMATS=""
LADDER=0
FRESH=0
IOS=0
NO_NODE=0
PULL=0
NO_CLONE=0
NO_LINK=0
NO_INSTALL=0
while [ $# -gt 0 ]; do
  case "$1" in
    --list) list ;;
    --help|-h) usage 0 ;;
    --ladder) LADDER=1 ;;
    --fresh) FRESH=1 ;;
    --ios) IOS=1 ;;
    --no-node) NO_NODE=1 ;;
    --no-clone) NO_CLONE=1 ;;
    --no-link) NO_LINK=1 ;;
    --no-install) NO_INSTALL=1 ;;
    --pull) PULL=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --formats) FORMATS="$2"; shift ;;
    --formats=*) FORMATS="${1#--formats=}" ;;
    -*) usage_fail "unknown flag $1 (--help for usage)" ;;
    *) [ -z "$REPO" ] || usage_fail "one repo, comma-list, or \"all\" at a time"; REPO="$1" ;;
  esac
  shift
done
[ -n "$REPO" ] || usage 1

bootstrap || exit 1
[ "$NO_INSTALL" = 1 ] && INSTALL_ARG="-DENKERLI_INSTALL_PLUGINS=OFF"
monorepo_prep || exit 1

if [ "$REPO" = "all" ]; then
  SELECTED=("${ORDER[@]}")
else
  IFS=',' read -ra SELECTED <<<"$REPO"   # a bare alias is just a 1-element list
fi

if [ "${#SELECTED[@]}" -gt 1 ]; then
  overall=0
  results=()
  for a in "${SELECTED[@]}"; do
    if build_one "$a"; then results+=("  OK     $a"); else results+=("  FAILED $a"); overall=1; fi
    # Fold in what that repo actually did, so a pass says WHAT passed.
    if [ -f "$SB_DETAIL/$a" ]; then
      while IFS= read -r line; do results+=("           $line"); done < "$SB_DETAIL/$a"
    fi
  done
  printf '\n— summary —\n%s\n' "$(printf '%s\n' "${results[@]}")"
  [ "$overall" = 0 ] && printf '\nAll done.\n' || printf '\nOne or more repos failed — see above.\n'
  exit "$overall"
else
  build_one "${SELECTED[0]}"
  status=$?
  [ "$status" = 0 ] && printf '\nDone.\n'
  exit "$status"
fi
